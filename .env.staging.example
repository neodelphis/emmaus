# ==============================================================================
# Emmaüs — Configuration du staging
# ==============================================================================
# Ce fichier est un modèle. La copie réelle s'appelle .env.staging et reste
# UNIQUEMENT sur le serveur de staging : elle n'est jamais versionnée ni copiée
# par GitHub Actions.
#
# 1. Copier ce modèle sur le serveur :
#      scp .env.staging.example staging:~/emmaus/.env.staging
# 2. Remplacer toutes les valeurs « REMPLACER... ».
# 3. Protéger le fichier :
#      ssh staging 'chmod 600 ~/emmaus/.env.staging'
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (réseau interne uniquement)
# ------------------------------------------------------------------------------
POSTGRES_USER=emmaus_staging
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_SOLIDE_SANS_CARACTERES_SPECIAUX
POSTGRES_DB=emmaus

# ------------------------------------------------------------------------------
# Sécurité de l'application
# ------------------------------------------------------------------------------
# Générer avec : openssl rand -hex 32
# Ne pas changer après la création des liens bénévoles.
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_64_CARACTERES

# ------------------------------------------------------------------------------
# Premier compte administrateur du staging
# ------------------------------------------------------------------------------
# Créé au premier démarrage uniquement. Mot de passe de 12 caractères minimum.
# Utiliser un mot de passe différent de la production et du développement.
ADMIN_EMAIL=admin@emmaus.fr
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_DE_STAGING
ADMIN_GENDER=homme

# ------------------------------------------------------------------------------
# URL publique et courriels
# ------------------------------------------------------------------------------
# URL HTTPS servie par Traefik.
FRONTEND_URL=https://emmaus-staging.neodelphis.ovh

# MailHog capture les courriels du staging. Accès via tunnel SSH :
#   ssh -N -L 8025:127.0.0.1:8025 staging
# puis http://localhost:8025
SMTP_FROM="Emmaus staging <ne-pas-repondre@emmaus.local>"

# ------------------------------------------------------------------------------
# Image déployée
# ------------------------------------------------------------------------------
# La CI surcharge cette valeur avec le tag sha-<commit> à déployer.
# IMAGE_TAG=staging

# ------------------------------------------------------------------------------
# Bon à savoir
# ------------------------------------------------------------------------------
# - POSTGRES_* ne sont appliquées qu'à la création du volume.
# - ADMIN_* ne crée le compte qu'au premier démarrage ; ensuite, passer par Compte.
# - Ne jamais committer .env.staging.
# - Vérifier la configuration Compose sur le serveur :
#      docker compose --env-file .env.staging -f docker-compose.staging.yml config
