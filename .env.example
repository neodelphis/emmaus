# Copier ce fichier vers .env puis remplacer toutes les valeurs.
# Ces valeurs restent locales et ne doivent jamais être commitées.

# Base de données PostgreSQL
POSTGRES_USER=emmaus
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-solide
POSTGRES_DB=emmaus

# Clé de signature des sessions et de chiffrement des liens individuels.
# Générer avec : openssl rand -hex 32
SECRET_KEY=remplacer-par-une-cle-aleatoire-de-64-caracteres

# Premier compte administrateur, créé au démarrage si aucun compte n'existe.
ADMIN_EMAIL=admin@emmaus.fr
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-de-12-caracteres-minimum
# Genre du premier compte pour l'affichage « Connecté » / « Connectée » : homme ou femme.
ADMIN_GENDER=homme

# URL publique de l'interface (utilisée dans les liens envoyés par courriel).
FRONTEND_URL=http://localhost:8080

# Expéditeur des courriels de développement (MailHog).
SMTP_FROM="Emmaus <ne-pas-repondre@emmaus.local>"
