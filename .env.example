# ==============================================================================
# Emmaüs — Disponibilités des bénévoles
# Configuration locale de développement
# ==============================================================================
#
# 1. Copier ce fichier :
#      cp .env.example .env
# 2. Remplacer les valeurs « remplacer-par... » par vos propres valeurs.
# 3. Démarrer la pile :
#      docker compose up -d --build
#
# Le fichier .env contient des secrets : il est ignoré par Git.
# Ne jamais le committer, ni le partager. Pour le protéger :
#      chmod 600 .env
#
# Toutes les variables ci-dessous sont lues par Docker Compose au démarrage.
# Après une modification, relancer `docker compose up -d`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de données PostgreSQL
# ------------------------------------------------------------------------------
# Ces valeurs servent à créer la base au premier démarrage.
# Attention : les modifier après la création du volume ne met pas à jour une base
# existante. Il faudrait migrer les données ou repartir d'un volume vierge.
#
# Éviter les caractères spéciaux (:@/#?%...) dans POSTGRES_PASSWORD : le mot de
# passe est réutilisé dans une URL de connexion. Préférer lettres, chiffres,
# tirets et underscores.
POSTGRES_USER=emmaus
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-solide
POSTGRES_DB=emmaus

# ------------------------------------------------------------------------------
# Sécurité des sessions et des liens bénévoles
# ------------------------------------------------------------------------------
# Clé secrète utilisée pour signer les sessions administrateur et chiffrer les
# jetons de lien personnel. Elle doit contenir au moins 32 caractères.
# Générer une valeur aléatoire avec :
#      openssl rand -hex 32
#
# Important : ne pas changer cette clé après avoir créé des liens bénévoles.
# Les liens déjà stockés ne pourraient plus être déchiffrés pour un renvoi, et
# les sessions administrateur en cours seraient invalidées.
SECRET_KEY=remplacer-par-une-cle-aleatoire-de-64-caracteres

# ------------------------------------------------------------------------------
# Premier compte administrateur
# ------------------------------------------------------------------------------
# Ce compte est créé automatiquement au premier démarrage, uniquement si aucun
# administrateur n'existe encore. Le mot de passe doit contenir au moins
# 12 caractères. Une fois le compte créé, utilisez la page Compte pour le changer.
#
# ADMIN_GENDER détermine le libellé de connexion :
#   homme -> « Connecté »
#   femme -> « Connectée »
# Cette variable est facultative : si elle est vide, le compte pourra renseigner
# son genre depuis la page Compte.
ADMIN_EMAIL=admin@emmaus.fr
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-de-12-caracteres-minimum
ADMIN_GENDER=homme

# ------------------------------------------------------------------------------
# Adresse publique de l'application
# ------------------------------------------------------------------------------
# Utilisée dans les liens personnels envoyés par courriel.
# En local avec Docker Compose : http://localhost:8080
# Avec le serveur Vite (npm run dev) : http://localhost:5173
# Ne pas mettre de slash final.
FRONTEND_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Courriels de développement
# ------------------------------------------------------------------------------
# Adresse d'expéditeur des courriels. MailHog les capture localement.
# Consulter les messages sur http://localhost:8025
#
# SMTP_HOST et SMTP_PORT ne sont pas à renseigner ici : Docker Compose les fixe
# sur le service MailHog (mailhog:1025).
SMTP_FROM="Emmaus <ne-pas-repondre@emmaus.local>"

# ------------------------------------------------------------------------------
# Bon à savoir
# ------------------------------------------------------------------------------
# - Les variables POSTGRES_* ne sont appliquées qu'à la création du volume.
# - ADMIN_* ne crée le compte qu'au premier démarrage ; ensuite, passer par Compte.
# - Changer SECRET_KEY invalide les sessions et les liens chiffrés.
# - Les valeurs d'exemple ne doivent pas être utilisées en production.
# - Vérifier la lecture du fichier avec :
#      docker compose --env-file .env config
